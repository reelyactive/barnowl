#!/usr/bin/env node

import Barnowl, { TestListener, UdpListener } from "../lib/barnowl.js";

const barnowl = new Barnowl({ enableMixing: true });

barnowl.addEventListener("raddec", (event) => {
  const raddec = event.detail;
  console.log(raddec.toFlattened());
});

barnowl.addListener(Barnowl, {}, UdpListener, {});
barnowl.addListener(Barnowl, {}, TestListener, {});

setInterval(() => { console.log(barnowl.getMetrics()); }, 5000);
